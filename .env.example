# Backblaze B2 (required)
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name

# Dev / deployment knobs (optional — defaults shown)
# API_PORT=8000                          # Backend port (FastAPI). Override if 8000 is taken.
# NEXT_PUBLIC_API_URL=http://localhost:8000  # Frontend → backend base URL.
# API_CORS_ORIGINS=http://localhost:3000     # Comma-separated frontend origins the API will accept.
# API_CORS_ORIGIN_REGEX=                     # Optional regex for dynamic preview-deploy origins.
