{
  "name": "b2-transformersjs-text-to-speech",
  "private": true,
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs",
    "dev": "sh scripts/dev.sh",
    "dev:web": "pnpm --filter @b2-transformersjs-text-to-speech/web dev",
    "dev:api": "cd services/api && .venv/bin/uvicorn main:app --reload --port ${API_PORT:-8000}",
    "build": "pnpm --filter @b2-transformersjs-text-to-speech/web build",
    "lint": "pnpm --filter @b2-transformersjs-text-to-speech/web lint",
    "lint:api": "cd services/api && .venv/bin/ruff check .",
    "test:api": "cd services/api && .venv/bin/python -m pytest",
    "check:structure": "cd services/api && .venv/bin/python -m pytest tests/test_structure.py -v",
    "test:e2e": "pnpm --filter @b2-transformersjs-text-to-speech/web exec playwright test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "@hono/node-server": "1.19.15",
      "body-parser": "2.3.0",
      "brace-expansion@<2": "1.1.18",
      "brace-expansion@>=2 <3": "2.1.2",
      "brace-expansion@>=4 <6": "5.0.9",
      "fast-uri": "3.1.5",
      "hono": "4.12.34",
      "ip-address": "10.3.1",
      "js-yaml": "4.3.1",
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "postcss-selector-parser": "7.1.3",
      "protobufjs": "7.6.5",
      "qs": "6.15.2",
      "sharp": "0.35.3",
      "shell-quote": "1.9.0",
      "tar": "7.5.21"
    }
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9"
  }
}
